<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/hugerte@1.0.9/skins/ui/oxide/skin.min.css">
		{# ag: site flavicon #}
		<link rel="icon" href="{{ asset('images/secure-file-color.svg') }}">
		<link rel="stylesheet" href="{{ asset('styles/site-wide-styling.css') }}">
		<link rel="stylesheet" href="{{ asset('styles/theme.css') }}">
		<link rel="stylesheet" href="{{ asset('styles/firm-styling.css') }}">
		<title>{% block title %}{{ app_name }}{% endblock %}</title>

		{% block styles %}{% endblock %}
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
	</head>
	<body class=""
		{# ag: datapoints for polling ajax calls #}
	    data-route="{{ app.request.attributes.get('_route') }}"
		data-chat-enabled="{{ is_granted('FEATURE_CHAT', firm) ? '1' : '0' }}"
		>
		<div class="d-flex min-vh-100">
			{% include 'layouts/sections/user-profiles-header-nav.html.twig' %}
			<div class="container-fluid justify-content-between d-flex flex-wrap p-4">
				{% block body %}{% endblock %}
			</div>
			{# ag: for page animation when ajax is called and page is loading/processing a submission #}
			<div id="page-loader" class="page-loader d-none">
				<div class="loading-dots">
					<span></span><span></span><span></span>
				</div>
				<div class="progress d-none" id="upload-progress">
					<div
						class="progress-bar progress-bar-striped progress-bar-animated"
						id="upload-progress-bar"
						role="progressbar"
						style="width: 0%"
						aria-valuenow="0"
						aria-valuemin="0"
						aria-valuemax="100"
						>
						0%
					</div>
				</div>
				<div class="d-none" id="page-loader-text-div">
					<p class="">Please Remain On The Page While Your Data Loads.</p>
				</div>
			</div>
			<audio id="new-notification-sound" preload="auto">
                <source src="{{ asset('sounds/notification-alert.mp3') }}" type="audio/mpeg">
            </audio>

		</div>

		{% block javascripts %}
		    <script src="https://cdn.hellosign.com/public/js/embedded/v2.11.1/embedded.production.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/hugerte@1/hugerte.min.js"></script>
            {{ encore_entry_script_tags('site-wide') }}
            {{ encore_entry_script_tags('firm') }}
            {{ encore_entry_script_tags('firm-datatable') }}
            {{ encore_entry_script_tags('firm-notification') }}
            {{ encore_entry_script_tags('firm-charts') }}
		{% endblock %}
	</body>
</html>
