{% extends 'firm-base.html.twig' %}

{% block title %}Firm Dashboard{% endblock %}

{% block body %}

    <div class="d-flex flex-column w-100 justify-content-between">

        <!-- Header -->
        {% include 'layouts/sections/search-bar-header.html.twig' %}
        {% include 'layouts/sections/announcement-banner.html.twig' %}

        <!-- Main Content -->
        <main class="
            justify-content-evenly
            h-auto
            flex-wrap
            container-fluid 
            mt-3">
            <div class="row">
                <div class="col-6">
                    <h1 class="text-primary">Welcome back, {{ user.getUserProfile.getFullName() }}!</h1>
                    <p class="small text-secondary">Manage and share your files securely with clients and team members.</p>
                </div>
                <div class="col-6 d-flex justify-content-end">
                    <a class="btn btn-success text-white d-flex align-items-center justify-content-center shadow-lg" href="{{ path('firm_upload_file_modal', { }) }}" data-bs-toggle="modal" data-modal-title="Upload Files" data-bs-target="#defaultTemplateModal" data-dynamic-load="true">
                        <i class="fas fa-cloud-upload-alt me-2"></i>
                        Upload Files
                    </a>
                </div>
            </div>

            <div class="row mt-4 d-flex justify-content-evenly">
                {% if user.getUserProfile.getUserType() != 'employee' %}
                    <div class="col border border-primary shadow-sm p-3 m-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3>Total Files - Firm</h3>
                            <i class="far fa-file-alt"></i>
                        </div>
                        <div>
                            <p class="ms-2 text-secondary">{{ firm.getFilesCount() }}</p>
                        </div>
                        <div class="ms-2 text-secondary">
                            <span class="fw-bold font-monospace text-success">{{ total_files_firm_percent_change }}</span> from last month 
                        </div>
                    </div>
                {% endif %}

                <div class="col border border-secondary shadow-sm p-3 m-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3>Total Files - User</h3>
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <p class="ms-2 text-secondary">{{ total_files }}</p>
                    </div>
                    <div class="ms-2 text-secondary">
                        <span class="fw-bold font-monospace text-success">+{{ this_week_file_activity }}</span> new this week 
                    </div>
                </div>

                <div class="col border border-warning shadow-sm p-3 m-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3>Firm Storage Used</h3>
                        <i class="fas fa-box-open"></i>
                    </div>
                    <div>
                        <p class="ms-2 text-secondary">{{ (used_storage / 1024 / 1024) | number_format(2) }} MB Used</p>
                        {# <p class="ms-2 text-secondary">47.2 GB</p> #}
                    </div>
                    <div class="ms-2 text-secondary">
                        <span class="
                            {% if used_percent >= 90 %}
                                text-danger
                            {% elseif used_percent >= 70 %}
                                text-warning
                            {% else %}
                                text-success
                            {% endif %}
                            fw-bold font-monospace">{{ used_percent|number_format(1) }}%</span> of {{ storage_plan.getStorageLabel() }} limit 
                        {# 62% of 75 GB limit  #}
                    </div>
                </div>

                <div class="col border border-info shadow-sm p-3 m-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3>Recent Activity</h3>
                        <i class="far fa-clock"></i>
                    </div>
                    <div>
                        <p class="ms-2 text-secondary">-</p>
                    </div>
                    <div class="ms-2 text-secondary">
                        <span class="text-success fw-bold font-monospace">{{ todays_file_activity }}</span> Files uploaded today 
                    </div>
                </div>
            </div>

            <div class="row py-4">
                <div class="firm-dashboard-file-view mt-2 mb-3">
                    <p class="mt-4">Eligible search fields: <strong>name, </strong>and <strong> file name</strong>.</p>
                    <div class="firm-dashboard-file-view-btns d-flex justify-content-between">
                        <div>
                            <button id="firm-download-table-selected-files" class="btn btn-primary text-white">
                                Download Selected
                            </button>
                            {% if user.getUserProfile.getUserType() != 'employee' %}
                                <button class="btn btn-secondary text-white" href="{{ path('firm_export_all_files_modal', { exportType: 'firm' }) }}" data-bs-toggle="modal" data-modal-title="Download All Files" data-bs-target="#defaultTemplateModal" data-dynamic-load="true" data-modal-size="modal-md">
                                    Download All Files
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <h3 class="text-secondary" id="dashboard-file-description-view">All Files</h3>
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle sort-by-dropdown-btn" type="button" id="dropdownSortByButton" data-bs-toggle="dropdown" aria-expanded="false">
                            Sort By
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownSortByButton">
                            <li>
                                <a class="dropdown-item" id="dashboard-files-received-btn">
                                    Recent Received Files
                                </a>
                            </li>
                            <li>
                                <a type="" class="dropdown-item" id="dashboard-files-sent-btn">
                                    Recent Sent Files
                                </a>
                            </li>
                            <li>
                                <a type="" class="dropdown-item" id="dashboard-files-all-btn">
                                    All Files
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <table id="firm-dashboard-view-file-table" 
                    class="table table-striped table-bordered align-middle"
                    data-user-role="{{ app.user.getUserProfile.getUserType }}"
                    >
                    <thead>
                        <tr>
                        <th><input type="checkbox" id="file-table-check-all-checkbox"></th>
                        {# <th>Name</th> #}
                        <th>File Name</th>
                        <th>Uploaded By</th>
                        <th>Assigned To</th>
                        <th>Created Date</th>
                        <th>Last Accessed At</th>
                        {# <th>Expiration Date</th> #}
                        <th>Edit</th>
                        </tr>
                    </thead>
                    {# <tbody>
                        {% for file in allFiles %}
                            {% if app.user.getId() != user.getId() %}
                                <tr>
                                    <td>{{ user.getId() }}</td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody> #}
                </table>
            </div>
        </main>
        <!-- Footer -->
        {% include 'layouts/sections/footer.html.twig' %}
    </div>

    {% if showTwoFactorPrompt %}
        <div
            class="modal fade"
            id="twoFactorPromptModal"
            tabindex="-1"
            aria-labelledby="twoFactorPromptModalLabel"
            aria-hidden="true"
            data-auto-show="true"
        >
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-secondary text-white">
                        <h5 class="modal-title" id="twoFactorPromptModalLabel">Protect Your Account</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        Add an extra layer of security by enabling two-factor authentication.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Later</button>
                        <a href="{{ path('firm_profile_view') }}" class="btn btn-primary">Enable 2FA</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# to throw notyf message after getting a controller flash call #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <script>
            document.addEventListener('DOMContentLoaded', function () {
                notyf.{{ label }}('{{ message|e('js') }}');
            });
            </script>
        {% endfor %}
    {% endfor %}

    {# ag: iterate modals needed, passed from the controller #}
    {% if modals_to_include is defined %}
        {% for modal in modals_to_include %}
            {% include 'layouts/modals/firm/' ~ modal %}
        {% endfor %}
    {% endif %}
    {% include 'layouts/modals/default-template.html.twig' %}

    {% block javascript %}
    {% endblock %}
{% endblock %}
