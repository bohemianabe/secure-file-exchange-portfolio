<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        {# ag: site flavicon #}
        <link rel="icon" href="{{ asset('images/secure-file-color.svg') }}">

        <link rel="stylesheet" href="{{ asset('styles/site-wide-styling.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/theme.css') }}">
    </head>
        <title>{% block title %}{{ app_name }}{% endblock %}</title>

    {% block styles %}{% endblock %}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    </head>

    <header class="navbar navbar-expand-lg bg-body-tertiary sticky-top border-bottom p-4">
        <div class="container">
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <a class="me-2" href="/"><img src="{{ asset('images/secure-file-color.png') }}" style="height:3rem;" /></a> 
                    <span class="vr mx-2"></span>
                    <span class="fw-semibold fs-5 text-secondary align-content-center">{{ app_name }}</span>
                </div>
            </div>

            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title text-secondary" id="offcanvasNavbarLabel">{{ app_name }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-lg-flex align-items-lg-center flex-wrap justify-content-lg-end"> 
                </div>
            </div>
        </div>
    </header>

    <body class="bg-light">
        <main class="container py-5">
            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
