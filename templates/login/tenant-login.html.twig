<!doctype html>
<html lang="en">
    <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

        {# ag: site flavicon #}
        <link rel="icon" href="{{ asset('images/secure-file-color.svg') }}">
        {# Bootstrap 5 via CDN ag: also list it before your custom css so it will override bootstrap #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('styles/site-wide-styling.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/theme.css') }}">
        {# base.html.twig #}

    <title>{% block title %}{{ app_name }}{% endblock %}</title>


    {% block styles %}{% endblock %}
    </head>
    {% if firm.getBannerImage() %}
        {% set bannerImage = firm_banner_path ~ '/' ~ firm.getBannerImage() %}
    {% else %}
        {% set bannerImage = 'images/file-room.jpg' %}
    {% endif %}

    {% if firm.getLogo() is not null %}
        {% set logoImage = firm_logo_path ~ '/' ~ firm.getLogo() %}
    {% else %}
        {% set logoImage = asset('images/secure-file-color.svg') %}
    {% endif %}
    <body>
        <main class="min-vh-100 d-flex bg-light-blue">
            <div class="container col-lg-7 col-md-7 col-sm-4 shadow-lg" 
                    style="background-image:url('{{ asset(bannerImage)}}');background-size:cover;background-repeat:no-repeat;background-position:center;position:relative;margin:0;
                    border-top-right-radius: 40px;
                    border-bottom-right-radius: 40px;
                    "
                    >
                    {% if bannerImage == 'images/stack-of-files.jpg' %}
                        <div class="login-overlay" style="position: absolute; inset: 0; background-color: rgba(0, 0, 0, 0.4);"></div>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="btn btn-success mt-4" href="{{ path('admin_firm_view', { firm: firm.getId() }) }}">
                        Back
                        </a>

                    {% elseif is_granted('ROLE_FIRM')  %}
                        <a class="btn btn-success mt-4" href="{{ path('firm_settings') }}">
                        Back
                        </a>
                    {% endif %}
            </div>

            <div class="container col-lg-5 col-md-5 col-sm-8
                d-flex align-items-center justify-content-center"
                >
                <div class="card bg-white shadow-lg">
                    <div class="card-body p-4">
                        {% for label, messages in app.flashes %}
                            <div class="mt-2">
                                {% for message in messages %}
                                    <div class="alert alert-{{ label }} m-3 text-muted text-center">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endfor %}

                        {% if error and error.messageKey !== 'code_invalid' %}
                            <div class="alert alert-danger text-center">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <div class="
                            row col-12 
                            d-flex justify-content-center align-items-center">
                                <div class="text-center d-flex justify-content-center flex-column">
                                    <img src="{{ asset(logoImage) }}" class="" style="height:5rem;width:auto;object-fit:contain;"/>
                                    <span class="mt-4 h5">{{ firm.getName() }}</span>
                                    <span class="mt-2 h6 fw-light text-secondary">&copy; {{ app_name }}</span>
                                </div>
                        </div>
                        <h5 class="mt-1 mb-4 fw-bolder text-center text-muted">Log In</h5>
                        {# ag: skip this message as I set up a better custom message #}

                        {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        <form method="post" action="{{ path('tenant_login', { account: firm.account }) }}">
                        {% endif %}
                            <div class="mb-3">
                                <label class="form-label" for="inputEmail">Email</label>
                                <input type="email" value="" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                            </div>

                            <div class="mb-3 position-relative">
                                <label class="form-label" for="inputPassword">Password</label>
                                <input type="password" name="_password" id="password" class="form-control mt-3" autocomplete="current-password" required>
                                <div class="mb-3 mt-3 text-end">
                                    <a href="{{ path('app_forgot_password_request') }}">Forgot Password</a>
                                </div>

                                <button type="button" id="togglePassword" class="btn btn-sm btn-outline-secondary position-absolute end-0 top-0 mt-0 mb-2 me-2" tabindex="-1">
                                    <i class="fas fa-building">Show</i>
                                </button>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="checkbox mb-3">
                                <input type="checkbox" name="_remember_me" id="_remember_me">
                                <label for="_remember_me">Remember me</label>
                            </div>
                            <button class="btn btn-primary w-100">Sign in</button>
                        {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        </form>
                        {% endif %}
                        {# ag: TODO LINK THIS TO THE CONTAO PAGE WHEN SET UP #}
                        <div class="d-flex justify-content-center col-12 mt-2">
                            <a href="#">Privacy Policy</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}

        <script>
            document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('password');
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    this.textContent = 'Hide';
                } else {
                    passwordInput.type = 'password';
                    this.textContent = 'Show';
                }
            });
        </script>
    {% endblock %}
    </body>
</html>





